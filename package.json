{
  "name": "anime-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "codes": "node scripts/codes.mjs",
    "roster": "node scripts/export-roster.mjs",
    "build:check": "wrangler deploy --dry-run --outdir work/build-check",
    "package": "node scripts/package-source.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "4.154.0" }
}
